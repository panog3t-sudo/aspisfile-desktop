#!/bin/bash
#
# Runs after the .pkg payload is installed. Best-effort move of the
# .pkg the user double-clicked into their Trash so they don't have to
# clean up their Downloads folder manually.
#
# Important: this is BEST-EFFORT only. macOS Tahoe (Darwin 25+)
# tightened TCC restrictions on user-data folders like ~/Downloads,
# and installd-spawned scripts can no longer move files there even as
# root unless Full Disk Access is granted. When it fails the .pkg just
# stays in Downloads — same friction as installing any other macOS
# app from outside the App Store. Acceptable.
#
# An earlier attempt (v1.7.3) added a Finder/AppleScript fallback for
# the TCC case; that triggered a "Installer wants to control Finder"
# permission prompt on first install that was scarier than the
# original problem. Reverted. Auto-trash is a nice-to-have, not a
# core feature.
#
# Apple-set env vars available here:
#   PACKAGE_PATH       — absolute path of the .pkg that ran this install
#   HOME / USER        — invoking user's home / username

set -u

PKG="${PACKAGE_PATH:-}"
if [ -n "$PKG" ] && [ -e "$PKG" ]; then
  TRASH="$HOME/.Trash"
  if [ -d "$TRASH" ]; then
    /bin/mv -f "$PKG" "$TRASH/" 2>/dev/null || true
  fi
fi

# #8 — auto-launch after install. A recipient installs the viewer specifically
# to open a file that's waiting; making them hunt for it in /Applications is
# pure friction (Mac has no desktop shortcut, and the .pkg finish page just
# says "install succeeded"). We open the app for them so the IdleScreen home
# is already up — and if they got here from a file link, the browser's pending
# aspisfile:// hand-off lands on a running app instead of a cold launch.
#
# The script runs as root (installd), so we must drop to the logged-in user to
# open a GUI app in their session. Best-effort: any failure (no console user,
# fast-user-switching, launchctl quirk) just leaves the app un-launched — the
# same as before this block existed. Never fail the install over it.
APP="/Applications/AspisFile Viewer.app"
if [ -d "$APP" ]; then
  CONSOLE_USER=$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || echo "")
  if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    CONSOLE_UID=$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || echo "")
    if [ -n "$CONSOLE_UID" ]; then
      /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/open -a "$APP" 2>/dev/null || true
    fi
  fi
fi

# Auto-close the leftover "Installation was successful" Installer window after
# the viewer has come up. The install + receipt are written by installd (not the
# Installer GUI), so closing the window is purely cosmetic and can't corrupt the
# install. Detached + delayed so installd finishes its flow first; killall (a
# plain process kill) needs NO permissions and shows NO TCC prompt — unlike the
# AppleScript approach that triggered a scary "control Finder" prompt in v1.7.3.
# Best-effort: if killall isn't there or Installer already closed, nothing happens.
( sleep 3; /usr/bin/killall Installer >/dev/null 2>&1 || true ) &

exit 0
